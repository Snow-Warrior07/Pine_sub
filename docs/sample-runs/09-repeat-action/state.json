    "analysis": {
      "summary": "Allow merchants to refund a captured payment in one or more parts, never exceeding the captured amount, safely under client retries, with every refund in the ledger and no card data in logs.",
      "acceptance_criteria": [
        {
          "id": "AC-1",
          "given": "a CAPTURED payment of INR 100.00",
          "when": "the merchant refunds INR 30.00",
          "then": "the refund succeeds, refundedAmount is 3000 paise and the status is PARTIALLY_REFUNDED"
        },
        {
          "id": "AC-2",
          "given": "a payment with INR 60.00 of 100.00 already refunded",
          "when": "the merchant requests a further INR 50.00 refund",
          "then": "the request is rejected and refundedAmount stays 6000 paise"
        },
        {
          "id": "AC-3",
          "given": "a partially refunded payment",
          "when": "the remaining balance is refunded",
          "then": "the status becomes REFUNDED"
        },
        {
          "id": "AC-4",
          "given": "a refund request with idempotency key K",
          "when": "the same request with key K is retried",
          "then": "the original refund is returned and no second refund or ledger entry is created"
        },
        {
          "id": "AC-5",
          "given": "a payment that is not captured, or an amount that is zero or not whole paise",
          "when": "a refund is requested",
          "then": "the request is rejected"
        },
        {
          "id": "AC-6",
          "given": "any successful refund",
          "when": "it is processed",
          "then": "a REFUND ledger entry with the refunded amount exists and no log line contains the card number"
        }
      ],
