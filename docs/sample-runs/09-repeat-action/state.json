      ],
      "decisions": [
        {
          "id": "ADR-1",
          "decision": "Partial refunds live in a new module, src/refunds.js",
          "rationale": "Keeps payments.js small and isolates the new behaviour for review and rollback."
        },
        {
          "id": "ADR-2",
          "decision": "Use the existing REFUND ledger entry type for partial refunds",
          "rationale": "Ledger entry types are agreed with Finance; settlement already nets REFUND entries correctly."
        },
        {
          "id": "ADR-3",
          "decision": "Idempotency keys are scoped per payment and stored in memory for now",
          "rationale": "Matches the in-memory store; flagged as a known risk for multi-instance deployment."
        }
      ],
      "risks": [
