# ── Required for the Express backend (src/server.ts) ─────────────────────────
# LLM provider key (OpenAI / Anthropic / etc.)
OPENAI_API_KEY=

# GitHub token with repo write access (to post issues)
GITHUB_TOKEN=

# Repo where issues are posted  e.g. owner/repo
ISSUE_REPO=HemantKumar01/triagebot-demo

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Required on Vercel (Next.js frontend) ─────────────────────────────────────
# URL of the separately-deployed Express backend.
# Leave empty to run the pipeline in-process (local dev only).
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
