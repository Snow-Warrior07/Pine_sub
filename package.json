{
  "name": "autonomous-engineering-org",
  "version": "1.0.0",
  "private": true,
  "description": "Specialised AI agents take one requirement through analysis, design, implementation, QA, security review and release, with a human approval gate before merge and deploy.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo": "node src/cli.ts demo",
    "demo:all": "node src/cli.ts demo-all",
    "run": "node src/cli.ts run",
    "approve": "node src/cli.ts approve",
    "reject": "node src/cli.ts reject",
    "resume": "node src/cli.ts resume",
    "status": "node src/cli.ts status",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "charts": "node scripts/generate-charts.ts",
    "check": "npm run typecheck && npm test"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
